{
	"name": "modern_graph_tool",
	"private": true,
	"version": "2.1.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cdn": "node scripts/build-cdn.js",
		"preview": "vite preview",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
		"i18n:check": "node scripts/check-translations.js",
		"i18n:missing": "node scripts/check-translations.js --write",
		"i18n:apply": "node scripts/apply-translations.js",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.23.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"playwright": "^1.62.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"bits-ui": "^2.18.1",
		"d3": "^7.9.0",
		"svelte-sonner": "^1.1.1"
	},
	"engines": {
		"node": ">=20"
	},
	"tsconfig": {
		"exclude": [
			"node_modules"
		]
	},
	"overrides": {
		"uuid": "^14.0.0"
	}
}
