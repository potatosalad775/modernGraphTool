# Build output and generated code. Prettier does not read .gitignore — neither the
# root one nor the nested ones (docs/.gitignore, project.inlang/.gitignore) — so
# without these, `npm run lint` fails on generated files as soon as anything has
# been built or compiled. The inlang entries are rewritten by every Paraglide
# compile, which `prepare` now runs on install.
/dist/
/dist-cdn/
/.svelte-kit/
/docs/build/
/docs/.docusaurus/
/docs/.cache-loader/
/docs_new/dist/
/docs_new/.astro/
/src/lib/paraglide/

# Migrated content, mechanically produced from the Docusaurus sources. Prettier
# reflows MDX prose and reindents JSX inside it, which would bury the real diff
# when the remaining pages are ported. Drop this once docs_new/ becomes docs/.
/docs_new/src/content/

# Mirrors project.inlang/.gitignore: inlang owns everything in here except settings.json,
# and rewrites it on every compile. Matching its rule rather than listing today's files
# means a new inlang artifact cannot break lint.
/project.inlang/*
!/project.inlang/settings.json

# Miscellaneous
/static/

# A JavaScript *fragment*, not a module: the CDN_MODE property that
# scripts/build-site-template.js splices into defaults/config.js. It cannot parse
# on its own, so neither Prettier nor ESLint can read it. The generated
# config.js is syntax-checked by the build script instead.
/site-template/config-cdn-mode.js
