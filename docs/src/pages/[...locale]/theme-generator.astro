---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ThemeGenerator from '../../components/tools/theme-generator/ThemeGenerator.svelte';
import { createTranslator, toToolLang } from '../../i18n/tools';
import '../../styles/infima-compat.css';

/**
 * Both locales are built from this one file. Starlight only localises sidebar
 * entries that point at content-collection slugs, and these tools are Astro
 * pages rather than content — but the Korean landing page links to them
 * relatively (`href="theme-generator/"` from `/ko/`), so `/ko/theme-generator`
 * has to exist. Docusaurus generated it implicitly; here it is explicit.
 */
export function getStaticPaths() {
	return [{ params: { locale: undefined } }, { params: { locale: 'ko' } }];
}

const lang = toToolLang(Astro.params.locale);
const t = createTranslator(lang);

const description = t(
	'Build a custom theme.css for modernGraphTool with a visual editor. Adjust colors, preview the result, and export the CSS.'
);
---

<StarlightPage
	frontmatter={{
		title: t('Theme Generator'),
		description: 'Theme Generator for modernGraphTool',
		template: 'splash',
		tableOfContents: false
	}}
>
	<div class="tgPageHeader">
		<p>{description}</p>
	</div>
	<ThemeGenerator {lang} client:load />
</StarlightPage>

<style>
	/*
	 * Matches `.cgPageHeader` / `.pbPageHeader` on the other two tool pages: a
	 * lead-in paragraph under Starlight's own `<h1>{title}</h1>` (`template:
	 * 'splash'` only drops the sidebar and TOC, it does not suppress the title).
	 */
	.tgPageHeader {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.tgPageHeader p {
		color: var(--sl-color-gray-3);
		margin-bottom: 1.5rem;
	}
</style>
