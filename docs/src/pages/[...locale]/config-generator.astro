---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ConfigEditor from '../../components/tools/config-editor/ConfigEditor.svelte';
import { createTranslator, toToolLang } from '../../i18n/tools';
import '../../styles/tools.css';

export function getStaticPaths() {
	return [{ params: { locale: undefined } }, { params: { locale: 'ko' } }];
}

const lang = toToolLang(Astro.params.locale);
const t = createTranslator(lang);

const title = t('Config Editor');
const description = t(
	'Build or edit your modernGraphTool config.js with a visual editor. Import an existing config, adjust settings, and export the result.'
);
---

<StarlightPage frontmatter={{ title, template: 'splash', tableOfContents: false }}>
	{/*
		`.tool-root` carries the tools' design tokens AND Starlight's `.not-content`
		escape hatch. Starlight wraps this slot in `.sl-markdown-content`, whose
		prose rules add a 1rem top margin to every element that follows a sibling —
		`button` included, which is what used to leave the second and third tab of a
		tab strip sitting a row below the first. See `styles/tools.css`.

		`template: 'splash'` only drops the sidebar and TOC; Starlight still renders
		its own `<h1>{title}</h1>` above this, so there is no heading here.
	*/}
	<div class="tool-root not-content">
		<p class="toolLead">{description}</p>
		<ConfigEditor client:load />
	</div>
</StarlightPage>
